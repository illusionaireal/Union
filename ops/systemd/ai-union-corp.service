[Unit]
Description=ai-union-corp bounded organization runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=union
Group=union
WorkingDirectory=/opt/union
EnvironmentFile=/etc/union/corp.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/union/.venv/bin/python -m ai_union.service --root ${UNION_ORGANIZATION_ROOT} --max-steps 32 --max-seconds 86400 --allow-unknown-cost
Restart=always
RestartPreventExitStatus=2
RestartSec=15
TimeoutStopSec=200
KillMode=control-group
UMask=0077
StateDirectory=union
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/union

[Install]
WantedBy=multi-user.target
